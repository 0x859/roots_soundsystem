{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Roots Soundsystem (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Roots Soundsystem (bez numba)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "NUMBA_DISABLE_JIT": "1" },
            "justMyCode": true
        },
        {
            "name": "Bieżący plik",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "pytest: bieżący plik testów",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-q", "-s", "${file}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "pytest: test wydajności toru",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-q", "-s", "tests/test_chain.py", "-k", "performance"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
