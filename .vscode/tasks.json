{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Testy: wszystkie",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m pytest -q",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Testy: wydajność toru",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m pytest -q -s tests/test_chain.py -k performance",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Lint: ruff",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m ruff check .",
            "problemMatcher": []
        },
        {
            "label": "Zależności: zainstaluj (dev)",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m pip install -r requirements.txt -r requirements-dev.txt",
            "problemMatcher": []
        },
        {
            "label": "Build: EXE (PyInstaller)",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}\\build_exe.ps1\"",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Uruchom aplikację",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe main.py",
            "problemMatcher": []
        }
    ]
}
